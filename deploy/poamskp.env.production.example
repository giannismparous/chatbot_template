# POAMSKP production environment template (Cloud Run / firebase profile)
# Copy for reference only — do NOT commit real values.
# In production, inject secrets via Secret Manager (--set-secrets), not plain env files.
# Full guide: deploy/POAMSKP-production-runbook.md

# --- Stack ---
STACK_PROFILE=firebase
FIRESTORE_CONTROL_PLANE=true
GCS_REGISTRY_FALLBACK=false

# --- GCP project & storage ---
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GCS_BUCKET=simasia-chatbot-prod-your-gcp-project-id
# Tenant object prefix inside the bucket (convention: clients/{client_id}/...)
GCS_CLIENT_PREFIX=clients
FIRESTORE_DATABASE=(default)
CLOUD_RUN_REGION=europe-west1
TENANT_CACHE_ROOT=/tmp/simasia-tenant-cache

# --- Security flags (must stay false in production) ---
ALLOW_INSECURE_CLIENT_ID=false
ALLOW_INSECURE_ADMIN=false

# --- Cloud Run Jobs (start disabled; enable in-process admin jobs only after smoke tests) ---
# Do NOT set CLOUD_RUN_JOBS_USE_GCLOUD=true — API image has no gcloud CLI.
# Run long jobs manually: gcloud run jobs execute chatbot-ingest --wait
CLOUD_RUN_JOBS_DISABLED=true
CLOUD_RUN_JOBS_USE_GCLOUD=false
CLOUD_RUN_JOB_PREFIX=chatbot

# --- Secrets (map from Secret Manager in Cloud Run; placeholders below) ---
# API and worker jobs both require ADMIN_API_TOKEN for firebase stack validation.
ADMIN_API_TOKEN=from-secret-manager
GEMINI_API_KEY=from-secret-manager
# Optional comma-separated key pool for chat LLM rotation
GEMINI_API_KEYS=from-secret-manager
GOOGLE_DRIVE_CREDENTIALS_JSON=from-secret-manager
WIDGET_KEY_HASH_SECRET=from-secret-manager

# Secret Manager resource names (reference — not env vars on Cloud Run):
#   chatbot-admin-api-token          → ADMIN_API_TOKEN
#   chatbot-gemini-api-key           → GEMINI_API_KEY
#   chatbot-gemini-api-keys          → GEMINI_API_KEYS (optional)
#   chatbot-drive-credentials        → GOOGLE_DRIVE_CREDENTIALS_JSON
#   chatbot-widget-key-hash-secret   → WIDGET_KEY_HASH_SECRET

# --- Tenant ---
# POAMSKP data uses client_id "default" in this deployment.
DEFAULT_CLIENT_ID=default

# --- Widget allowed origins (NOT env vars — set on widget key at rotation) ---
# Configure via POST /v1/admin/clients/default/widget-keys/rotate:
#   https://www.poamskp.gr
#   https://poamskp.gr
# The API enforces Origin binding per widget key. Wrong origin → 403.

# --- CORS ---
# FastAPI CORS is allow_origins=["*"] for browser preflight.
# Production auth is x-client-key + origin binding, not CORS credentials.

# --- POAMSKP website embed (client-side; not Cloud Run env) ---
# Point the site widget at the Cloud Run API URL and send:
#   Header: x-client-key: wk_<rotated-production-key>
# Do not embed Gemini keys or admin tokens in the website.
