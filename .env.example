# Copy to .env and fill in real values. Never commit .env.

# Stack: local (default, no Firebase) | firebase (production target) | enterprise (not implemented)
STACK_PROFILE=local

# Required for chat + embeddings (local and firebase profiles)
GEMINI_API_KEY=your_gemini_api_key_here
# Optional comma-separated pool for chat LLM rotation (Phase 7)
GEMINI_API_KEYS=

# Local MVP client fallback when ALLOW_INSECURE_CLIENT_ID=true (never in production)
DEFAULT_CLIENT_ID=default
DEFAULT_MODEL=gemini-2.5-flash-lite
EMBEDDING_MODEL=gemini-embedding-001

# Widget / tenant auth (Phase 1)
ALLOW_INSECURE_CLIENT_ID=false
CLIENT_REGISTRY_PATH=packages/config/clients/registry.yaml

# Admin MVP: x-admin-token → platform_admin (Phase 1)
ADMIN_API_TOKEN=dev_admin_token_change_me
# Local dev only — never enable in production or firebase profile
ALLOW_INSECURE_ADMIN=false

# Google Drive sync (optional — local dev only)
# Path to service-account JSON, or inline JSON. Share each Drive folder with the service account email.
GOOGLE_DRIVE_CREDENTIALS_JSON=service-account.json

# SQLite (optional — legacy shared defaults)
DB_SQLITE_PATH=

# Privacy-gated trace + aggregate metrics (Phase 9)
TRACES_SQLITE_PATH=

# External API connector (optional)
API_CONNECTOR_BASE_URL=
API_CONNECTOR_API_KEY=

# Qdrant (optional)
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_COLLECTION=chatbot_chunks

# Firebase/GCP (firebase profile — Phase 19+ production storage)
# GOOGLE_CLOUD_PROJECT=your-gcp-project
# GCS_BUCKET=simasia-chatbot-prod-your-gcp-project
# CLOUD_RUN_REGION=europe-west1
# TENANT_CACHE_ROOT=/tmp/simasia-tenant-cache
# CLOUD_RUN_JOBS_DISABLED=true
# CLOUD_RUN_JOBS_USE_GCLOUD=false
# CLOUD_RUN_JOB_PREFIX=chatbot
# FIRESTORE_CONTROL_PLANE=true
# WIDGET_KEY_HASH_SECRET=           # Secret Manager in prod — required for firebase control plane
# GCS_REGISTRY_FALLBACK=false       # one-release fallback to platform/registry.yaml
# FIRESTORE_DATABASE=(default)
