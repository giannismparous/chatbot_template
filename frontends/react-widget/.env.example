# --- Local backend (default dev) ---
# VITE_CHATBOT_API_BASE=http://localhost:8000
# VITE_CLIENT_KEY=wk_test_default
# VITE_CLIENT_ID=default

# --- Production POAMSKP test harness (copy to .env or .env.local) ---
VITE_CHATBOT_API_BASE=https://simasia-chatbot-api-tqdnz23eua-ew.a.run.app
VITE_CLIENT_ID=default
VITE_CLIENT_KEY=wk_REPLACE_WITH_WIDGET_KEY
VITE_CHAT_API_VERSION=v2
VITE_CHAT_STREAMING=true
VITE_SESSION_STORAGE=session

# Optional: override admin API base (defaults to VITE_CHATBOT_API_BASE)
# VITE_ADMIN_API_BASE=https://simasia-chatbot-api-tqdnz23eua-ew.a.run.app

# Origin binding: production keys allow https://www.poamskp.gr and https://poamskp.gr only.
# For localhost (npm run dev), rotate a temporary test key with http://localhost:5173 allowed.
